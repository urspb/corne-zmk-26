#include <behaviors.dtsi>
#include "custom_behaviors.dtsi"
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_de.h"

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        display-name = "UrsBase";
                        bindings = <
   &kp DE_LT &kp Q            &kp W        &kp E       &kp R        &kp T        &kp DE_Z    &kp U        &kp I        &kp O         &kp P            &kp DE_U_UMLAUT 
   &kp TAB   &kp A            &hml LCTRL S &hml LALT D &hml LGUI F  &kp G        &kp H       &hml LGUI J  &hml LALT K  &hml LCTRL L  &kp SEMI         &kp DE_A_UMLAUT
   &kp GRAVE &hml LSHIFT DE_Y &kp X        &kp C       &kp V        &kp B        &kp N       &kp M        &kp COMMA    &kp DOT       &hml RSHFT FSLH  &kp DE_SZ
                                           &lt 3 ESC   &lt 1 SPACE  &lt 2 TAB    &lt 2 BKSP  &lt 1 RET    &lt 3 DEL
                        >;
                };
                navi {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        display-name = "Navi";
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                          	        &trans       &trans       &trans         &trans   &trans   &trans
                        >;
                };

                numpad {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        display-name = "NumPad";
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR    &kp PRCNT  &kp DE_LT   &kp N7   &kp N8  &kp N9  &kp DE_SLASH &kp DE_ASTERISK
   &kp LCTRL &trans   &trans &trans   &trans      &trans     &kp N0      &kp N4   &kp N5  &kp N6  &kp COMMA    &kp DE_MINUS
   &kp LSHFT &trans   &trans &trans   &trans      &trans     &kp GRAVE   &kp N1   &kp N2  &kp N3  &kp DOT      &kp DE_PLUS
                    	     &trans   &kp SPACE   &trans     &trans      &kp RET  &trans
                        >;
                };

                brackets {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        display-name = "Brackets";
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                    	     &trans   &trans   &trans      &trans    &trans    &trans
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
